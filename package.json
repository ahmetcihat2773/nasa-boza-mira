{
  "name": "space-mission-design-game",
  "version": "0.0.0",
  "private": true,
  "description": "Space Mission Design Game - monorepo root (NASA Space Apps Challenge)",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck typecheck:root",
    "lint": "turbo run lint lint:root",
    "typecheck:root": "tsc -p tsconfig.json",
    "lint:root": "eslint scripts eslint.config.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "globals": "^17.14.0",
    "prettier": "3.10.1",
    "turbo": "2.11.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.55.0"
  }
}
