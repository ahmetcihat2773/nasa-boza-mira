{
  "name": "@space-mission/api",
  "version": "0.0.0",
  "private": true,
  "description": "Local API (Hono on Node): SQLite storage and the optional Flight Director.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types --disable-warning=ExperimentalWarning --watch src/server.ts",
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@hono/node-server": "2.1.8",
    "better-sqlite3": "12.11.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.18"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "22.20.5",
    "drizzle-kit": "0.31.11",
    "vitest": "4.1.12"
  }
}
