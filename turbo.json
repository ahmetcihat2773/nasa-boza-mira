{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {},
    "test": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#typecheck:root": {
      "inputs": ["scripts/**", "tsconfig.base.json", "tsconfig.json"]
    },
    "//#lint:root": {
      "inputs": ["scripts/**", "eslint.config.js", "*.js"]
    }
  }
}
