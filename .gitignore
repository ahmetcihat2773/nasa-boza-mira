!.yarn/plugins
!.yarn/releases
!.yarn/versions
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.tsbuildinfo
.eslintcache
.stylelintcache
.npm/

# ---------- Build output (Vite, Next.js, React, Phaser, etc.) ----------
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
.svelte-kit/
.vite/
.parcel-cache/
.turbo/
.vercel/
.netlify/
.cache/
storybook-static/

# ---------- Testing & coverage ----------
coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/
junit.xml

# ---------- Local databases & game data ----------
*.sqlite
*.sqlite3
*.db
saves/
saved_missions/
leaderboard.local.json
logs/
*.log
tmp/
temp/

# ---------- Editors & IDEs ----------
