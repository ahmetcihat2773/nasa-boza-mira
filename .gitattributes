# Keep text files on LF in the working tree on every OS, so generated data
# (data/*.json) and TypeScript do not change between Windows and other machines.
* text=auto eol=lf

*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sql text eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.glb binary
*.gltf text eol=lf
*.pdf binary
*.woff binary
*.woff2 binary
*.sqlite binary
*.db binary
